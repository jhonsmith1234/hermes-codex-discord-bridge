+    error_text: str | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class TaskAnswerResult:
+    """Safe result returned to an authenticated off-turn answer command."""
+
+    accepted: bool
+    status: str
+    message: str
+
+
+@dataclass(frozen=True, slots=True)
+class TaskRecoveryResult:
+    """Result returned by an authenticated manual recovery command."""
+
+    accepted: bool
+    status: str
+    message: str
+    record: TaskRecord | None = None
+
+
+_UNSET = object()
+
+
+def _canonical_request(request: TaskRequest) -> str:
+    # A replay of one inbound event must compare equal even when processed at a
+    # different time.  The event identity and plan define the fingerprint;
+    # generated timestamps and request ids do not.
+    payload = request.to_dict()
+    payload.pop("request_id", None)
+    payload.pop("created_at", None)
+    payload.pop("reply_target", None)
+    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _request_fingerprint(request: TaskRequest) -> str:
+    return hashlib.sha256(_canonical_request(request).encode("utf-8")).hexdigest()
+
+
+class CodexTaskStore:
+    """Thread-safe SQLite store for the bridge's request/task mapping."""
+
+    def __init__(self, path: str | os.PathLike[str]) -> None:
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.RLock()
+        self._conn = sqlite3.connect(str(self.path), check_same_thread=False, timeout=10.0)
+        self._conn.row_factory = sqlite3.Row
+        with self._lock:
+            self._conn.execute("PRAGMA journal_mode=WAL")
+            self._conn.execute("PRAGMA busy_timeout=10000")
+            self._conn.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS codex_app_tasks (
+                    request_id TEXT PRIMARY KEY,
+                    source_platform TEXT NOT NULL,
+                    source_sender_id TEXT NOT NULL,
+                    source_conversation_id TEXT NOT NULL,
+                    source_thread_id TEXT,
+                    source_message_id TEXT NOT NULL,
+                    conversation_type TEXT NOT NULL,
+                    source_profile TEXT,
+                    purpose TEXT NOT NULL,
+                    steps_json TEXT NOT NULL,
+                    target_services_json TEXT NOT NULL,
+                    scope_text TEXT NOT NULL,
+                    completion_conditions_json TEXT NOT NULL,
+                    reply_platform TEXT NOT NULL,
+                    reply_conversation_id TEXT NOT NULL,
+                    reply_thread_id TEXT,
+                    state TEXT NOT NULL,
+                    codex_thread_id TEXT,
+                    codex_turn_id TEXT,
+                    result_text TEXT,
+                    error_text TEXT,
+                    fingerprint TEXT NOT NULL,
+                    created_at REAL NOT NULL,
+                    updated_at REAL NOT NULL,
+                    delivery_state TEXT NOT NULL DEFAULT 'pending',
+                    delivery_attempts INTEGER NOT NULL DEFAULT 0,
+                    delivery_error TEXT,
+                    delivery_notice_state TEXT,
+                    pending_server_request_id TEXT,
+                    pending_server_request_method TEXT,
+                    pending_server_request_summary TEXT,
+                    pending_server_request_expires_at REAL,
+                    UNIQUE(source_platform, source_conversation_id, source_message_id)
+                );
+                CREATE INDEX IF NOT EXISTS codex_app_tasks_state_idx
+                    ON codex_app_tasks(state, updated_at);
+                CREATE TABLE IF NOT EXISTS codex_task_notifications (
+                    notification_id TEXT PRIMARY KEY,
+                    task_id TEXT NOT NULL,
+                    generation INTEGER NOT NULL,
+                    expected_state TEXT NOT NULL,
+                    server_request_id TEXT,
+                    content TEXT NOT NULL,
+                    status TEXT NOT NULL DEFAULT 'pending',
+                    attempts INTEGER NOT NULL DEFAULT 0,
+                    error_text TEXT,
+                    delivery_obligation_id TEXT,
+                    message_id TEXT,
+                    continuation_message_ids_json TEXT NOT NULL DEFAULT '[]',
+                    created_at REAL NOT NULL,
+                    updated_at REAL NOT NULL,
+                    UNIQUE(task_id, expected_state, server_request_id)
+                );
+                CREATE INDEX IF NOT EXISTS codex_task_notifications_recovery_idx
+                    ON codex_task_notifications(status, updated_at);
+                """
+            )
+            self._ensure_schema_columns()
+            self._migrate_fingerprints()
+            self._conn.commit()
+        # The store can contain Discord routing metadata and results.  Keep the
+        # file private even when the caller created it with a permissive umask.
+        try:
+            os.chmod(self.path, 0o600)
+        except OSError:
+            logger.debug("could not tighten task store permissions", exc_info=True)
+
+    def close(self) -> None:
+        with self._lock:
+            self._conn.close()
+
+    def __enter__(self) -> "CodexTaskStore":
+        return self
+
+    def __exit__(self, *_exc: Any) -> None:
+        self.close()
+
+    def _ensure_schema_columns(self) -> None:
+        """Add fields introduced after the first private-store version."""
+
+        columns = {row[1] for row in self._conn.execute("PRAGMA table_info(codex_app_tasks)")}
+        additions = {
+            "source_profile": "TEXT",
+            "delivery_state": "TEXT NOT NULL DEFAULT 'pending'",
+            "delivery_attempts": "INTEGER NOT NULL DEFAULT 0",
+            "delivery_error": "TEXT",
+            "delivery_notice_state": "TEXT",
+            "pending_server_request_id": "TEXT",
+            "pending_server_request_method": "TEXT",
+            "pending_server_request_summary": "TEXT",
+            "pending_server_request_expires_at": "REAL",
+        }
+        for name, definition in additions.items():
+            if name not in columns:
+                self._conn.execute(f"ALTER TABLE codex_app_tasks ADD COLUMN {name} {definition}")
+
+    def _migrate_fingerprints(self) -> None:
+        """Normalize hashes written by the pre-replay-safe schema."""
+
+        rows = self._conn.execute("SELECT * FROM codex_app_tasks").fetchall()
+        for row in rows:
+            request = self._record(row)
+            fingerprint = _request_fingerprint(request.request)
+            if row["fingerprint"] != fingerprint:
+                self._conn.execute(
+                    "UPDATE codex_app_tasks SET fingerprint=? WHERE request_id=?",
+                    (fingerprint, request.request.request_id),
+                )
+
+    def register(self, request: TaskRequest) -> tuple[TaskRecord, bool]:
+        """Insert a task, or return the exact prior task for a retried message."""
+
+        fingerprint = _request_fingerprint(request)
+        origin, plan = request.origin, request.plan
+        with self._lock:
+            self._conn.execute("BEGIN IMMEDIATE")
+            try:
+                existing = self._conn.execute(
+                    "SELECT * FROM codex_app_tasks WHERE source_platform=? AND source_conversation_id=? "
+                    "AND source_message_id=?",
+                    origin.dedupe_key,
+                ).fetchone()
+                if existing is not None:
+                    if existing["fingerprint"] != fingerprint:
+                        raise TaskConflictError(
+                            "Discord message was already admitted with a different task payload"
+                        )
+                    self._conn.commit()
+                    return self._record(existing), False
+                self._conn.execute(
+                    """
+                    INSERT INTO codex_app_tasks (
+                        request_id, source_platform, source_sender_id, source_conversation_id,
+                        source_thread_id, source_message_id, conversation_type, source_profile, purpose, steps_json,
+                        target_services_json, scope_text, completion_conditions_json, reply_platform,
+                        reply_conversation_id, reply_thread_id, state, fingerprint, created_at, updated_at
+                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+                    """,
+                    (
+                        request.request_id, origin.platform, origin.sender_id, origin.conversation_id,
+                        origin.thread_id, origin.message_id, origin.conversation_type, origin.profile, plan.purpose,
+                        _json_array(plan.steps), _json_array(plan.target_services), plan.scope,
+                        _json_array(plan.completion_conditions), origin.platform, origin.conversation_id,
+                        origin.thread_id, TaskState.QUEUED.value, fingerprint, request.created_at, request.created_at,
+                    ),
+                )
+                self._conn.commit()
+                return self.get(request.request_id), True
+            except Exception:
+                self._conn.rollback()
+                raise
+
+    def get(self, request_id: str) -> TaskRecord:
+        with self._lock:
+            row = self._conn.execute("SELECT * FROM codex_app_tasks WHERE request_id=?", (request_id,)).fetchone()
+        if row is None:
+            raise KeyError(request_id)
+        return self._record(row)
+
+    def pending_for_origin(
+        self, *, platform: str, profile: str | None, conversation_id: str, sender_id: str,
+    ) -> list[TaskRecord]:
+        """Return only live waiting requests for one authenticated origin."""
+        with self._lock:
+            rows = self._conn.execute(
+                "SELECT * FROM codex_app_tasks WHERE state=? AND source_platform=? "
+                "AND source_profile IS ? AND source_conversation_id=? AND source_sender_id=? "
+                "AND pending_server_request_id IS NOT NULL ORDER BY updated_at ASC",
+                (TaskState.WAITING_FOR_USER.value, platform, profile, conversation_id, sender_id),
+            ).fetchall()
+        return [self._record(row) for row in rows]
+
+    def recoverable(self) -> list[TaskRecord]:
+        with self._lock:
+            rows = self._conn.execute(
+                "SELECT * FROM codex_app_tasks WHERE state IN (?, ?, ?, ?) ORDER BY updated_at ASC",
+                (
+                    TaskState.QUEUED.value, TaskState.RUNNING.value,
+                    TaskState.WAITING_FOR_USER.value, TaskState.UNKNOWN.value,
+                ),
+            ).fetchall()
+        return [self._record(row) for row in rows]
+
+    def undelivered(self) -> list[TaskRecord]:
+        """Return settled/waiting records whose completion notice is not confirmed."""
+
+        with self._lock:
+            rows = self._conn.execute(
+                "SELECT * FROM codex_app_tasks WHERE state IN (?, ?, ?, ?) "
+                "AND COALESCE(delivery_state, 'pending') != 'delivered' ORDER BY updated_at ASC",
+                (
+                    TaskState.WAITING_FOR_USER.value, TaskState.SUCCEEDED.value,
+                    TaskState.FAILED.value, TaskState.CANCELLED.value,
+                ),
+            ).fetchall()
+        return [self._record(row) for row in rows]
+
+    def ensure_notification(self, record: TaskRecord, content: str) -> TaskNotification:
+        """Create one durable notification version, or return the existing one.
+
+        ``waiting_for_user`` is keyed by the live server-request id, so two MCP
+        requests on one task cannot share an acknowledgement.  Terminal state
+        notices are keyed by the task state and have their own generation.
+        """
+        expected_state = TaskState(record.state)
+        server_request_id = (
+            str(record.pending_server_request_id)
+            if expected_state == TaskState.WAITING_FOR_USER and record.pending_server_request_id
+            else None
+        )
+        content = str(content or "")
+        with self._lock:
+            self._conn.execute("BEGIN IMMEDIATE")
+            try:
+                if server_request_id is None:
+                    existing = self._conn.execute(
+                        "SELECT * FROM codex_task_notifications WHERE task_id=? AND expected_state=? "
+                        "AND server_request_id IS NULL ORDER BY generation DESC LIMIT 1",
+                        (record.request.request_id, expected_state.value),
+                    ).fetchone()
+                else:
+                    existing = self._conn.execute(
+                        "SELECT * FROM codex_task_notifications WHERE task_id=? AND expected_state=? "
+                        "AND server_request_id=? ORDER BY generation DESC LIMIT 1",
+                        (record.request.request_id, expected_state.value, server_request_id),
+                    ).fetchone()
+                if existing is not None:
+                    self._conn.commit()
+                    return self._notification(existing)
+                next_generation = self._conn.execute(
+                    "SELECT COALESCE(MAX(generation), 0) + 1 FROM codex_task_notifications WHERE task_id=?",
+                    (record.request.request_id,),
+                ).fetchone()[0]
+                now = time.time()
+                notification_id = str(uuid.uuid4())
+                self._conn.execute(
+                    """INSERT INTO codex_task_notifications (
+                        notification_id, task_id, generation, expected_state, server_request_id,
+                        content, status, attempts, created_at, updated_at
+                    ) VALUES (?, ?, ?, ?, ?, ?, 'pending', 0, ?, ?)""",
+                    (
+                        notification_id, record.request.request_id, int(next_generation), expected_state.value,
+                        server_request_id, content, now, now,
+                    ),
+                )
+                self._conn.commit()
+                return self.notification(notification_id)
+            except Exception:
+                self._conn.rollback()
+                raise
+
+    def notification(self, notification_id: str) -> TaskNotification:
+        with self._lock:
+            row = self._conn.execute(
+                "SELECT * FROM codex_task_notifications WHERE notification_id=?", (notification_id,)
+            ).fetchone()
+        if row is None:
+            raise KeyError(notification_id)
+        return self._notification(row)
+
+    def unresolved_notifications(self) -> list[TaskNotification]:
+        """Return only new notification rows lacking a confirmed platform receipt."""
+        with self._lock:
+            rows = self._conn.execute(
+                "SELECT * FROM codex_task_notifications WHERE status NOT IN ('delivered', 'superseded') "
+                "ORDER BY updated_at ASC"
+            ).fetchall()
+        return [self._notification(row) for row in rows]
+
+    def supersede_unresolved_notifications(self, task_id: str, *, expected_state: TaskState,
+                                           reason: str) -> int:
+        """Retire unlinked notices before an explicit retry creates a new version."""
+        with self._lock:
+            cursor = self._conn.execute(
+                """UPDATE codex_task_notifications SET status='superseded', error_text=?, updated_at=?
+                   WHERE task_id=? AND expected_state=?
+                     AND status NOT IN ('delivered', 'superseded')
+                     AND delivery_obligation_id IS NULL""",
+                (str(reason or "Superseded by an explicit retry")[:1000], time.time(),
+                 str(task_id), TaskState(expected_state).value),
+            )
+            self._conn.commit()
+            return int(cursor.rowcount)
+
+    def mark_notification_attempt(self, notification_id: str, *, force: bool = False) -> TaskNotification:
+        with self._lock:
+            where = "notification_id=?"
+            params: list[Any] = [notification_id]
+            if not force:
+                where += " AND status NOT IN ('delivered', 'injected')"
+            self._conn.execute(
+                f"UPDATE codex_task_notifications SET status='attempting', attempts=attempts+1, "
+                f"error_text=NULL, updated_at=? WHERE {where}",
+                [time.time(), *params],
+            )
+            self._conn.commit()
+            return self.notification(notification_id)
+
+    def mark_notification_injected(
+        self, notification_id: str, *, expected_state: TaskState, generation: int,
+    ) -> bool:
+        """Record gateway admission only; this is never a delivery acknowledgement."""
+        with self._lock:
+            cursor = self._conn.execute(
+                "UPDATE codex_task_notifications SET status='injected', error_text=NULL, updated_at=? "
+                "WHERE notification_id=? AND expected_state=? AND generation=? AND status != 'delivered'",
+                (time.time(), notification_id, TaskState(expected_state).value, int(generation)),
+            )
+            self._conn.commit()
+            return bool(cursor.rowcount)
+
+    def mark_notification_failed(self, notification_id: str, error_text: str) -> TaskNotification:
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_task_notifications SET status='pending', error_text=?, updated_at=? "
+                "WHERE notification_id=? AND status != 'delivered'",
+                (str(error_text or "")[:1000], time.time(), notification_id),
+            )
+            self._conn.commit()
+            return self.notification(notification_id)
+
+    def mark_notification_superseded(self, notification_id: str, reason: str) -> TaskNotification:
+        """Retire an unconfirmed notice whose task has advanced to another version."""
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_task_notifications SET status='superseded', error_text=?, updated_at=? "
+                "WHERE notification_id=? AND status != 'delivered'",
+                (str(reason or "Superseded by a newer task state")[:1000], time.time(), notification_id),
+            )
+            self._conn.commit()
+            return self.notification(notification_id)
+
+    def link_notification_obligation(
+        self, notification_id: str, *, expected_state: TaskState, generation: int,
+        obligation_id: str,
+    ) -> bool:
+        """CAS-link the common delivery-ledger row to this notification version."""
+        with self._lock:
+            cursor = self._conn.execute(
+                "UPDATE codex_task_notifications SET delivery_obligation_id=?, updated_at=? "
+                "WHERE notification_id=? AND expected_state=? AND generation=? "
+                "AND (delivery_obligation_id IS NULL OR delivery_obligation_id=?)",
+                (
+                    str(obligation_id), time.time(), notification_id,
+                    TaskState(expected_state).value, int(generation), str(obligation_id),
+                ),
+            )
+            self._conn.commit()
+            return bool(cursor.rowcount)
+
+    def mark_notification_delivered(
+        self, notification_id: str, *, expected_state: TaskState, generation: int,
+        message_id: str | None, continuation_message_ids: tuple[str, ...] = (),
+    ) -> bool:
+        """CAS a notification to delivered with the platform's actual receipt.
+
+        The expected state and generation are part of the update predicate.  A
+        delayed ACK for an older waiting notice therefore cannot mark a later
+        succeeded notice as delivered.
+        """
+        ids = tuple(str(value) for value in continuation_message_ids if value)
+        with self._lock:
+            cursor = self._conn.execute(
+                """UPDATE codex_task_notifications SET status='delivered', error_text=NULL,
+                    message_id=?, continuation_message_ids_json=?, updated_at=?
+                   WHERE notification_id=? AND expected_state=? AND generation=?
+                     AND status != 'delivered'""",
+                (
+                    str(message_id) if message_id else None, json.dumps(list(ids), separators=(",", ":")),
+                    time.time(), notification_id, TaskState(expected_state).value, int(generation),
+                ),
+            )
+            self._conn.commit()
+            return bool(cursor.rowcount)
+
+    def _notification(self, row: sqlite3.Row) -> TaskNotification:
+        try:
+            continuation_ids = tuple(str(value) for value in json.loads(row["continuation_message_ids_json"] or "[]"))
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continuation_ids = ()
+        return TaskNotification(
+            notification_id=row["notification_id"], task_id=row["task_id"],
+            generation=int(row["generation"]), expected_state=TaskState(row["expected_state"]),
+            server_request_id=row["server_request_id"], content=row["content"], status=row["status"],
+            attempts=int(row["attempts"] or 0), error_text=row["error_text"],
+            delivery_obligation_id=row["delivery_obligation_id"], message_id=row["message_id"],
+            continuation_message_ids=continuation_ids, created_at=float(row["created_at"]),
+            updated_at=float(row["updated_at"]),
+        )
+
+    def mark_delivery_attempt(self, request_id: str, error_text: str | None = None) -> TaskRecord:
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_app_tasks SET delivery_state='attempting', "
+                "delivery_attempts=delivery_attempts+1, delivery_error=?, updated_at=? "
+                "WHERE request_id=?",
+                (error_text, time.time(), request_id),
+            )
+            self._conn.commit()
+            return self.get(request_id)
+
+    def mark_delivery_failed(self, request_id: str, error_text: str) -> TaskRecord:
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_app_tasks SET delivery_state='pending', delivery_error=?, "
+                "delivery_notice_state=NULL, updated_at=? "
+                "WHERE request_id=?",
+                (error_text, time.time(), request_id),
+            )
+            self._conn.commit()
+            return self.get(request_id)
+
+    def mark_delivery_accepted(self, request_id: str, state: TaskState) -> TaskRecord:
+        """Record gateway injection acceptance, not confirmed Discord delivery."""
+
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_app_tasks SET delivery_state='accepted', delivery_error=NULL, "
+                "delivery_notice_state=?, updated_at=? "
+                "WHERE request_id=?",
+                (TaskState(state).value, time.time(), request_id),
+            )
+            self._conn.commit()
+            return self.get(request_id)
+
+    def mark_delivered(self, request_id: str) -> TaskRecord:
+        with self._lock:
+            self._conn.execute(
+                "UPDATE codex_app_tasks SET delivery_state='delivered', delivery_error=NULL, "
+                "delivery_notice_state=(SELECT state FROM codex_app_tasks WHERE request_id=?), updated_at=? "
+                "WHERE request_id=?",
+                (request_id, time.time(), request_id),
+            )
+            self._conn.commit()
+            return self.get(request_id)
+
+    def transition(
+        self,
+        request_id: str,
+        state: TaskState,
+        *,
+        codex_thread_id: str | None | object = _UNSET,
+        codex_turn_id: str | None | object = _UNSET,
+        result_text: str | None | object = _UNSET,
+        error_text: str | None | object = _UNSET,
+        pending_server_request_id: str | None | object = _UNSET,
+        pending_server_request_method: str | None | object = _UNSET,
+        pending_server_request_summary: str | None | object = _UNSET,
+        pending_server_request_expires_at: float | None | object = _UNSET,
+        now: float | None = None,
+    ) -> TaskRecord:
+        state = TaskState(state)
+        with self._lock:
+            current = self.get(request_id)
+            if state not in _ALLOWED_TRANSITIONS[current.state]:
+                raise InvalidStateTransition(f"{current.state.value} -> {state.value}")
+            fields: dict[str, Any] = {"state": state.value, "updated_at": float(time.time() if now is None else now)}
+            for column, value in (
+                ("codex_thread_id", codex_thread_id), ("codex_turn_id", codex_turn_id),
+                ("result_text", result_text), ("error_text", error_text),
+                ("pending_server_request_id", pending_server_request_id),
+                ("pending_server_request_method", pending_server_request_method),
+                ("pending_server_request_summary", pending_server_request_summary),
+                ("pending_server_request_expires_at", pending_server_request_expires_at),
+            ):
+                if value is not _UNSET:
+                    fields[column] = value
+            assignments = ", ".join(f"{column}=?" for column in fields)
+            values = [fields[column] for column in fields] + [request_id]
+            self._conn.execute(f"UPDATE codex_app_tasks SET {assignments} WHERE request_id=?", values)
+            self._conn.commit()
+            return self.get(request_id)
+
+    def _record(self, row: sqlite3.Row) -> TaskRecord:
+        origin = DiscordOrigin(
+            sender_id=row["source_sender_id"], conversation_id=row["source_conversation_id"],
+            message_id=row["source_message_id"], thread_id=row["source_thread_id"],
+            conversation_type=row["conversation_type"], platform=row["source_platform"],
+            profile=row["source_profile"] if "source_profile" in row.keys() else None,
+        )
+        plan = TaskPlan(
+            purpose=row["purpose"], steps=tuple(_load_array(row["steps_json"])),
+            target_services=tuple(_load_array(row["target_services_json"])), scope=row["scope_text"],
+            completion_conditions=tuple(_load_array(row["completion_conditions_json"])),
+        )
+        request = TaskRequest(
+            request_id=row["request_id"], origin=origin, plan=plan, created_at=float(row["created_at"]),
+        )
+        return TaskRecord(
+            request=request, state=TaskState(row["state"]), codex_thread_id=row["codex_thread_id"],
+            codex_turn_id=row["codex_turn_id"], result_text=row["result_text"], error_text=row["error_text"],
+            updated_at=float(row["updated_at"]),
+            delivery_state=row["delivery_state"] if "delivery_state" in row.keys() else "pending",
+            delivery_attempts=int(row["delivery_attempts"] or 0) if "delivery_attempts" in row.keys() else 0,
+            delivery_error=row["delivery_error"] if "delivery_error" in row.keys() else None,
+            delivery_notice_state=row["delivery_notice_state"] if "delivery_notice_state" in row.keys() else None,
+            pending_server_request_id=(row["pending_server_request_id"]
+                                      if "pending_server_request_id" in row.keys() else None),
+            pending_server_request_method=(row["pending_server_request_method"]
+                                           if "pending_server_request_method" in row.keys() else None),
+            pending_server_request_summary=(row["pending_server_request_summary"]
+                                            if "pending_server_request_summary" in row.keys() else None),
+            pending_server_request_expires_at=(float(row["pending_server_request_expires_at"])
+                                               if "pending_server_request_expires_at" in row.keys()
+                                               and row["pending_server_request_expires_at"] is not None else None),
+        )
+
+
+def _json_array(values: tuple[str, ...]) -> str:
+    return json.dumps(list(values), ensure_ascii=False, separators=(",", ":"))
+
+
+def _load_array(value: str) -> list[str]:
+    loaded = json.loads(value)
+    return [str(item) for item in loaded]
+
+
+def _callable_accepts_keyword(callable_obj: Callable[..., Any], name: str) -> bool:
+    """Keep third-party/test executors compatible with the callback extension."""
+    try:
+        parameters = inspect.signature(callable_obj).parameters.values()
+    except (TypeError, ValueError):
+        return True
+    return any(parameter.kind == inspect.Parameter.VAR_KEYWORD or parameter.name == name
+               for parameter in parameters)
+
+
+class TaskExecutor(Protocol):
+    def execute(
+        self, task: TaskRecord, *, on_thread_started: Callable[[str], None] | None = None,
+        on_turn_started: Callable[[str], None] | None = None,
+        on_server_request: Callable[[Any], None] | None = None,
+        on_server_request_settled: Callable[[Any, str], None] | None = None,
+    ) -> ExecutionResult: ...
+
+    def inspect(self, task: TaskRecord) -> ExecutionResult | None: ...
+
+
+class CodexAppServerExecutor:
+    """Run one request through a separate, persistent Codex app-server thread."""
+
+    def __init__(
+        self,
+        *,
+        cwd: str,
+        codex_bin: str = "codex",
+        codex_home: str | None = None,
+        turn_timeout: float = 600.0,
+        session_factory: Callable[..., Any] | None = None,
+        client_capabilities: Mapping[str, Any] | None = None,
+    ) -> None:
+        self.cwd = cwd
+        self.codex_bin = codex_bin
+        self.codex_home = codex_home
+        self.turn_timeout = turn_timeout
+        self._session_factory = session_factory
+        self.client_capabilities = dict(client_capabilities or {"mcpServerOpenaiFormElicitation": True})
+        self._sessions: dict[str, Any] = {}
+        self._sessions_lock = threading.RLock()
+
+    def _new_session(self) -> Any:
+        factory = self._session_factory
+        if factory is None:
+            from agent.transports.codex_app_server_session import CodexAppServerSession
+
+            factory = CodexAppServerSession
+        kwargs = {
+            "cwd": self.cwd, "codex_bin": self.codex_bin, "codex_home": self.codex_home,
+            "client_capabilities": self.client_capabilities,
+        }
+        try:
+            return factory(**kwargs)
+        except TypeError as exc:
+            # Keep small test/fallback session factories compatible with the
+            # pre-capability constructor while the real session opts into the
+            # OpenAI form elicitation capability.
+            if "client_capabilities" not in str(exc):
+                raise
+            kwargs.pop("client_capabilities")
+            return factory(**kwargs)
+
+    def execute(
+        self, task: TaskRecord, *, on_thread_started: Callable[[str], None] | None = None,
+        on_turn_started: Callable[[str], None] | None = None,
+        on_server_request: Callable[[Any], None] | None = None,
+        on_server_request_settled: Callable[[Any, str], None] | None = None,
+    ) -> ExecutionResult:
+        session = self._new_session()
+        with self._sessions_lock:
+            self._sessions[task.request.request_id] = session
+        try:
+            thread_id = session.ensure_started()
+            if on_thread_started is not None:
+                on_thread_started(thread_id)
+            turn = session.run_turn(
+                render_codex_prompt(task.request), turn_timeout=self.turn_timeout,
+                on_turn_started=on_turn_started,
+                on_server_request=on_server_request,
+                on_server_request_settled=on_server_request_settled,
+                allow_pending_server_requests=True,
+            )
+            thread_id = turn.thread_id or thread_id
+            if getattr(turn, "waiting_for_user", False):
+                detail = getattr(turn, "server_request_summary", None)
+                return ExecutionResult(
+                    state=TaskState.WAITING_FOR_USER, codex_thread_id=thread_id,
+                    codex_turn_id=turn.turn_id, result_text=turn.final_text or None,
+                    error_text=turn.error or detail or "Codex requires user confirmation before continuing",
+                )
+            if turn.error:
+                if turn.interrupted and not turn.should_retire:
+                    state = TaskState.CANCELLED
+                elif turn.should_retire or _looks_transport_uncertain(turn.error):
+                    state = TaskState.UNKNOWN
+                else:
+                    state = TaskState.FAILED
+                return ExecutionResult(
+                    state=state, codex_thread_id=thread_id, codex_turn_id=turn.turn_id,
+                    result_text=turn.final_text or None, error_text=turn.error,
+                )
+            return ExecutionResult(
+                state=TaskState.SUCCEEDED, codex_thread_id=thread_id, codex_turn_id=turn.turn_id,
+                result_text=turn.final_text,
+            )
+        except (BrokenPipeError, ConnectionError, OSError, TimeoutError) as exc:
+            return ExecutionResult(state=TaskState.UNKNOWN, error_text=str(exc))
+        except Exception as exc:  # The settlement is unknown if the executor boundary failed unexpectedly.
+            logger.exception("Codex app-server task executor failed")
+            return ExecutionResult(state=TaskState.UNKNOWN, error_text=str(exc))
+        finally:
+            with self._sessions_lock:
+                self._sessions.pop(task.request.request_id, None)
+            try:
+                session.close()
+            except Exception:
+                logger.debug("failed to close Codex app-server session", exc_info=True)
+
+    def pending(self, request_id: str) -> Any | None:
+        """Return the live session's pending request, if the task is still running."""
+        with self._sessions_lock:
+            session = self._sessions.get(request_id)
+        if session is None:
+            return None
+        try:
+            return session.pending_server_request()
+        except Exception:
+            logger.debug("could not inspect pending Codex request", exc_info=True)
+            return None
+
+    def answer(
+        self, request_id: str, server_request_id: str, response: Mapping[str, Any], *,
+        before_release: Callable[[], None] | None = None,
+    ) -> Any:
+        """Answer one live request without starting a second Codex turn."""
+        with self._sessions_lock:
+            session = self._sessions.get(request_id)
+        if session is None:
+            from agent.transports.codex_app_server_session import ServerRequestAnswerResult
+
+            return ServerRequestAnswerResult(False, "not_live", "No live Codex app-server session exists for this task")
+        return session.answer_server_request(server_request_id, response, before_release=before_release)
+
+    def close(self) -> None:
+        """Wake and close live sessions before a gateway worker pool shuts down."""
+        with self._sessions_lock:
+            sessions = list(self._sessions.values())
+        for session in sessions:
+            try:
+                session.close()
+            except Exception:
+                logger.debug("failed to close live Codex task session", exc_info=True)
+
+    def inspect(self, task: TaskRecord) -> ExecutionResult | None:
+        """Read persisted Codex state without starting a new turn or retrying work."""
+
+        if not task.codex_thread_id:
+            return None
+        from agent.transports.codex_app_server import CodexAppServerClient
+
+        client = CodexAppServerClient(codex_bin=self.codex_bin, codex_home=self.codex_home)
+        try:
+            client.initialize(client_name="hermes-task-reconciler", client_title="Hermes Task Reconciler", client_version="0.1")
+            payload = client.request(
+                "thread/read", {"threadId": task.codex_thread_id, "includeTurns": True}, timeout=20
+            )
+            return _execution_result_from_thread_read(payload, task.codex_turn_id)
+        except (BrokenPipeError, ConnectionError, OSError, TimeoutError) as exc:
+            return ExecutionResult(state=TaskState.UNKNOWN, codex_thread_id=task.codex_thread_id, error_text=str(exc))
+        except Exception as exc:
+            logger.exception("Codex app-server task reconciliation failed")
+            return ExecutionResult(state=TaskState.UNKNOWN, codex_thread_id=task.codex_thread_id, error_text=str(exc))
+        finally:
+            client.close()
+
+
+def _looks_transport_uncertain(error: str) -> bool:
+    haystack = error.lower()
+    return any(
+        marker in haystack
+        for marker in (
+            "timed out", "timeout", "subprocess exited", "broken pipe", "connection",
+            "stdin closed", "app-server startup failed",
+        )
+    )
+
+
+def _execution_result_from_thread_read(payload: Mapping[str, Any], turn_id: str | None) -> ExecutionResult:
+    thread = payload.get("thread") or {}
+    thread_id = thread.get("id")
+    status = thread.get("status") or {}
+    active_flags = set(status.get("activeFlags") or []) if isinstance(status, Mapping) else set()
+    if status.get("type") == "active" and active_flags.intersection(
+        {"waitingOnApproval", "waitingOnUser", "waitingOnInput"}
+    ):
+        return ExecutionResult(
+            state=TaskState.WAITING_FOR_USER, codex_thread_id=thread_id, codex_turn_id=turn_id,
+            error_text="Codex task is waiting for user confirmation or input",
+        )
+
+    turns = [turn for turn in (thread.get("turns") or []) if isinstance(turn, Mapping)]
+    if turn_id:
+        selected = next((turn for turn in turns if turn.get("id") == turn_id), None)
+        if selected is None:
+            return ExecutionResult(
+                state=TaskState.UNKNOWN, codex_thread_id=thread_id, codex_turn_id=turn_id,
+                error_text="Persisted Codex turn id was not present in thread/read; manual review required",
+            )
+    else:
+        selected = turns[-1] if turns else None
+    if selected is None:
+        if status.get("type") == "active":
+            return ExecutionResult(state=TaskState.RUNNING, codex_thread_id=thread_id, codex_turn_id=turn_id)
+        return None
+    selected_id = selected.get("id") or turn_id
+    items = selected.get("items") or []
+    result_text = next(
+        (item.get("text") for item in reversed(items) if isinstance(item, Mapping) and item.get("type") == "agentMessage"),
+        None,
+    )
+    turn_status = str(selected.get("status") or "").lower()
+    if turn_status in {"completed", "complete", "succeeded"}:
+        return ExecutionResult(
+            state=TaskState.SUCCEEDED, codex_thread_id=thread_id, codex_turn_id=selected_id,
+            result_text=result_text,
+        )
+    if turn_status in {"interrupted", "cancelled", "canceled"}:
+        return ExecutionResult(
+            state=TaskState.CANCELLED, codex_thread_id=thread_id, codex_turn_id=selected_id,
+            result_text=result_text,
+        )
+    if turn_status in {"failed", "error"} or selected.get("error"):
+        error = selected.get("error")
+        return ExecutionResult(
+            state=TaskState.FAILED, codex_thread_id=thread_id, codex_turn_id=selected_id,
+            result_text=result_text, error_text=str(error) if error else "Codex turn failed",
+        )
+    return ExecutionResult(state=TaskState.RUNNING, codex_thread_id=thread_id, codex_turn_id=selected_id)
+
+
+class CodexTaskBridge:
+    """Durable admission and asynchronous settlement for Codex app tasks."""
+
+    def __init__(
+        self,
+        store: CodexTaskStore,
+        executor: TaskExecutor,
+        *,
+        max_workers: int = 1,
+        pool: ThreadPoolExecutor | None = None,
+        on_settle: Callable[..., bool] | None = None,
+        notification_renderer: Callable[[TaskRecord], str] | None = None,
+        reconcile_attempts: int = 3,
+        reconcile_delay: float = 2.0,
+    ) -> None:
+        self.store = store
+        self.executor = executor
+        self._pool = pool or ThreadPoolExecutor(max_workers=max_workers, thread_name_prefix="hermes-codex-task")
+        self._owns_pool = pool is None
+        self._futures: dict[str, Future[Any]] = {}
+        self._lock = threading.Lock()
+        self._on_settle = on_settle
+        self._notification_renderer = notification_renderer
+        self._notification_injected_this_process: set[str] = set()
+        self._reconcile_attempts = max(1, int(reconcile_attempts))
+        self._reconcile_delay = max(0.0, float(reconcile_delay))
+
+    def accept(self, request: TaskRequest) -> tuple[TaskRecord, bool]:
+        record, created = self.store.register(request)
+        if created:
+            self._schedule(request.request_id, self._run)
+        return record, created
+
+    def recover(self) -> None:
+        """Recover queued work and reconcile interrupted work without resubmitting it."""
+
+        for record in self.store.recoverable():
+            if record.state == TaskState.QUEUED:
+                self._schedule(record.request.request_id, self._run)
+            elif record.state == TaskState.WAITING_FOR_USER and record.pending_server_request_id:
+                # The app-server session is a live in-process RPC.  After a
+                # gateway restart it no longer exists, so an old Discord
+                # answer must never be applied to a newly-created turn.
+                settled = self.store.transition(
+                    record.request.request_id, TaskState.UNKNOWN,
+                    error_text=(
+                        f"Pending Codex server request {record.pending_server_request_id} expired when the "
+                        "Hermes gateway restarted; the original app-server session is gone and the task "
+                        "was not replayed. Manual review required."
+                    ),
+                    pending_server_request_id=None, pending_server_request_method=None,
+                    pending_server_request_summary=None, pending_server_request_expires_at=None,
+                )
+                self._notify_settlement(settled)
+            elif record.codex_thread_id:
+                self._schedule(record.request.request_id, self._reconcile)
+            else:
+                # There is no safe Codex identity to inspect or retry.  Never
+                # duplicate a request whose process died before persistence.
+                settled = self.store.transition(
+                    record.request.request_id, TaskState.UNKNOWN,
+                    error_text="Task interrupted before Codex thread id was persisted; manual review required",
+                )
+                self._notify_settlement(settled)
+        self._recover_notifications()
+
+    def future(self, request_id: str) -> Future[Any] | None:
+        with self._lock:
+            return self._futures.get(request_id)
+
+    def reconcile(self, request_id: str) -> TaskRecord:
+        """Refresh an existing Codex task by read-only lookup; never re-submit it."""
+
+        record = self.store.get(request_id)
+        outcome = self._inspect_until_settled(record)
+        if outcome is None:
+            return record
+        return self._settle(request_id, outcome)
+
+    def manual_recover(
+        self, task_id: str, action: str, *, origin: DiscordOrigin,
+        confirmation: str | None = None,
+    ) -> TaskRecoveryResult:
+        """Inspect, explicitly retry, or cancel one owner-owned unknown task.
+
+        Inspection is read-only and never creates a new Codex turn.  Retrying
+        and cancelling require separate literal confirmations because an
+        ``unknown`` task may have completed externally before its final state
+        reached Hermes.
+        """
+        try:
+            record = self.store.get(task_id)
+        except KeyError:
+            return TaskRecoveryResult(False, "not_found", "No Codex task exists for that task id")
+        if not _same_origin(record.request.origin, origin):
+            return TaskRecoveryResult(False, "forbidden", "That Codex task is not owned by this Discord DM")
+
+        normalized_action = str(action or "").strip().lower()
+        if normalized_action in {"status", "show"}:
+            return TaskRecoveryResult(True, "status", "No recovery action was taken", record)
+
+        if normalized_action in {"inspect", "reconcile"}:
+            if record.state != TaskState.UNKNOWN:
+                return TaskRecoveryResult(
+                    False, "stale",
+                    f"Manual inspection is only needed for unknown tasks; this task is {record.state.value}",
+                    record,
+                )
+            if self._has_active_future(task_id):
+                return TaskRecoveryResult(
+                    False, "busy", "A recovery check is already running for this task; try again shortly", record,
+                )
+            if not record.codex_thread_id:
+                unchanged = self.store.transition(
+                    task_id, TaskState.UNKNOWN,
+                    error_text=(
+                        "Read-only inspection could not start because no Codex thread id was persisted. "
+                        "Choose an explicit retry or cancel action after reviewing the original request."
+                    ),
+                )
+                return TaskRecoveryResult(
+                    True, "inconclusive", unchanged.error_text or "Inspection was inconclusive", unchanged,
+                )
+            try:
+                outcome = self._inspect_until_settled(record)
+            except Exception as exc:
+                logger.exception("manual Codex task inspection failed")
+                outcome = ExecutionResult(
+                    state=TaskState.UNKNOWN, codex_thread_id=record.codex_thread_id,
+                    error_text=f"Read-only inspection failed: {type(exc).__name__}",
+                )
+            if outcome is not None and outcome.state in TERMINAL_STATES:
+                settled = self._settle(task_id, outcome)
+                return TaskRecoveryResult(
+                    True, "reconciled",
+                    f"Read-only inspection settled the task as {settled.state.value}", settled,
+                )
+            if outcome is None:
+                message = (
+                    "Read-only inspection returned no Codex state. No new turn was started; "
+                    "choose an explicit retry or cancel action after reviewing the original request."
+                )
+                thread_id = None
+                turn_id = None
+            elif outcome.state == TaskState.RUNNING:
+                message = (
+                    "Read-only inspection still sees the Codex turn as running. No new turn was started, "
+                    "and the live approval session cannot be recreated here; choose retry or cancel only "
+                    "after reviewing the possible duplicate effect."
+                )
+                thread_id = outcome.codex_thread_id
+                turn_id = outcome.codex_turn_id
+            elif outcome.state == TaskState.WAITING_FOR_USER:
+                message = (
+                    "Read-only inspection found a Codex request waiting for input, but the live app-server "
+                    "session is not attached to this gateway. The old request cannot be answered; choose "
+                    "retry or cancel explicitly."
+                )
+                thread_id = outcome.codex_thread_id
+                turn_id = outcome.codex_turn_id
+            else:
+                message = (
+                    outcome.error_text
+                    or "Read-only inspection could not determine a terminal Codex state. "
+                    "No new turn was started; choose retry or cancel explicitly."
+                )
+                thread_id = outcome.codex_thread_id
+                turn_id = outcome.codex_turn_id
+            unchanged = self.store.transition(
+                task_id, TaskState.UNKNOWN,
+                codex_thread_id=thread_id if thread_id is not None else _UNSET,
+                codex_turn_id=turn_id if turn_id is not None else _UNSET,
+                error_text=message,
+            )
+            return TaskRecoveryResult(True, "inconclusive", message, unchanged)
+
+        if normalized_action in {"retry", "replay"}:
+            if str(confirmation or "").strip().upper() != "RETRY":
+                return TaskRecoveryResult(
+                    False, "confirmation_required",
+                    "Explicit confirmation required: append the literal RETRY to acknowledge possible duplicate effects",
+                    record,
+                )
+            if record.state != TaskState.UNKNOWN:
+                return TaskRecoveryResult(
+                    False, "stale", f"Only unknown tasks can be retried; this task is {record.state.value}", record,
+                )
+            if self._has_active_future(task_id):
+                return TaskRecoveryResult(
+                    False, "busy", "A recovery check is already running for this task; try again shortly", record,
+                )
+            retry_note = (
+                "Owner explicitly requested a retry after manual review. The previous Codex run may have "
+                "completed before its final state was recorded; duplicate external effects are possible."
+            )
+            try:
+                queued = self.store.transition(
+                    task_id, TaskState.QUEUED,
+                    codex_thread_id=None, codex_turn_id=None, result_text=None, error_text=retry_note,
+                    pending_server_request_id=None, pending_server_request_method=None,
+                    pending_server_request_summary=None, pending_server_request_expires_at=None,
+                )
+            except InvalidStateTransition:
+                current = self.store.get(task_id)
+                return TaskRecoveryResult(
+                    False, "stale", f"The task changed state before retry; it is now {current.state.value}", current,
+                )
+            self.store.supersede_unresolved_notifications(
+                task_id, expected_state=TaskState.UNKNOWN,
+                reason="Superseded by the owner's explicit retry command",
+            )
+            try:
+                self._schedule(task_id, self._run)
+            except Exception as exc:
+                logger.exception("could not schedule manually retried Codex task %s", task_id)
+                failed = self.store.transition(
+                    task_id, TaskState.UNKNOWN,
+                    error_text=f"Explicit retry could not be queued: {type(exc).__name__}",
+                )
+                self._notify_settlement(failed)
+                return TaskRecoveryResult(False, "schedule_failed", failed.error_text or "Retry failed", failed)
+            return TaskRecoveryResult(
+                True, "queued",
+                "Explicit retry accepted. A new Codex turn may duplicate effects from the unknown run; "
+                "wait for the completion notice.", queued,
+            )
+
+        if normalized_action in {"cancel", "abandon"}:
+            if str(confirmation or "").strip().upper() != "CANCEL":
+                return TaskRecoveryResult(
+                    False, "confirmation_required",
+                    "Explicit confirmation required: append the literal CANCEL to abandon the unknown task",
+                    record,
+                )
+            if record.state != TaskState.UNKNOWN:
+                return TaskRecoveryResult(
+                    False, "stale", f"Only unknown tasks can be cancelled; this task is {record.state.value}", record,
+                )
+            if self._has_active_future(task_id):
+                return TaskRecoveryResult(
+                    False, "busy", "A recovery check is already running for this task; try again shortly", record,
+                )
+            try:
+                cancelled = self.store.transition(
+                    task_id, TaskState.CANCELLED,
+                    error_text="Cancelled by the owner through manual recovery",
+                    pending_server_request_id=None, pending_server_request_method=None,
+                    pending_server_request_summary=None, pending_server_request_expires_at=None,
+                )
+            except InvalidStateTransition:
+                current = self.store.get(task_id)
+                return TaskRecoveryResult(
+                    False, "stale", f"The task changed state before cancellation; it is now {current.state.value}", current,
+                )
+            self._notify_settlement(cancelled)
+            return TaskRecoveryResult(True, "cancelled", "The unknown task was cancelled locally", cancelled)
+
+        return TaskRecoveryResult(
+            False, "invalid_action",
+            "Unknown recovery action; use status, inspect, retry, or cancel",
+            record,
+        )
+
+    def close(self, *, wait: bool = True) -> None:
+        close_executor = getattr(self.executor, "close", None)
+        if callable(close_executor):
+            try:
+                close_executor()
+            except Exception:
+                logger.debug("failed to close live Codex task sessions", exc_info=True)
+        if self._owns_pool:
+            self._pool.shutdown(wait=wait, cancel_futures=True)
+
+    def _run(self, request_id: str) -> TaskRecord:
+        record = self.store.get(request_id)
+        try:
+            self.store.transition(request_id, TaskState.RUNNING)
+            callbacks: dict[str, Callable[..., None]] = {
+                "on_thread_started": lambda thread_id: self.store.transition(
+                    request_id, TaskState.RUNNING, codex_thread_id=thread_id
+                ),
+                "on_turn_started": lambda turn_id: self.store.transition(
+                    request_id, TaskState.RUNNING, codex_turn_id=turn_id
+                ),
+                "on_server_request": lambda pending: self._mark_server_request(request_id, pending),
+                "on_server_request_settled": lambda pending, reason: self._mark_server_request_settled(
+                    request_id, pending, reason
+                ),
+            }
+            execute_kwargs = {
+                name: callback for name, callback in callbacks.items()
+                if _callable_accepts_keyword(self.executor.execute, name)
+            }
+            outcome = self.executor.execute(record, **execute_kwargs)
+        except Exception as exc:
+            logger.exception("Codex task settlement failed")
+            outcome = ExecutionResult(state=TaskState.UNKNOWN, error_text=str(exc))
+        return self._settle(request_id, outcome)
+
+    def _reconcile(self, request_id: str) -> TaskRecord:
+        record = self.store.get(request_id)
+        outcome = self._inspect_until_settled(record)
+        if outcome is None:
+            return record
+        return self._settle(request_id, outcome)
+
+    def _inspect_until_settled(self, record: TaskRecord) -> ExecutionResult | None:
+        """Bounded startup polling for a still-active Codex thread.
+
+        ``thread/read`` is read-only.  A few short rechecks cover a turn that
+        is completing while Hermes restarts without turning recovery into an
+        unbounded background waiter; an explicitly running task remains
+        recoverable for the next status/restart pass.
+        """
+
+        current = record
+        for attempt in range(self._reconcile_attempts):
+            outcome = self.executor.inspect(current)
+            if outcome is None or outcome.state != TaskState.RUNNING or attempt + 1 >= self._reconcile_attempts:
+                return outcome
+            if self._reconcile_delay:
+                time.sleep(self._reconcile_delay)
+            current = self.store.get(record.request.request_id)
+            if current.state not in {
+                TaskState.RUNNING, TaskState.WAITING_FOR_USER, TaskState.UNKNOWN,
+            }:
+                return None
+        return outcome
+
+    def _schedule(self, request_id: str, worker: Callable[[str], TaskRecord]) -> None:
+        with self._lock:
+            current = self._futures.get(request_id)
+            if current is not None and not current.done():
+                return
+            self._futures[request_id] = self._pool.submit(worker, request_id)
+
+    def _has_active_future(self, request_id: str) -> bool:
+        with self._lock:
+            future = self._futures.get(request_id)
+            return future is not None and not future.done()
+
+    def _settle(self, request_id: str, outcome: ExecutionResult) -> TaskRecord:
+        clear_error = outcome.state in {TaskState.SUCCEEDED, TaskState.CANCELLED}
+        settled = self.store.transition(
+            request_id,
+            outcome.state,
+            codex_thread_id=outcome.codex_thread_id if outcome.codex_thread_id is not None else _UNSET,
+            codex_turn_id=outcome.codex_turn_id if outcome.codex_turn_id is not None else _UNSET,
+            result_text=outcome.result_text if outcome.result_text is not None else _UNSET,
+            error_text=(
+                outcome.error_text
+                if outcome.error_text is not None
+                else None
+                if clear_error
+                else _UNSET
+            ),
+            pending_server_request_id=None,
+            pending_server_request_method=None,
+            pending_server_request_summary=None,
+            pending_server_request_expires_at=None,
+        )
+        self._notify_settlement(settled)
+        # Delivery bookkeeping is a second durable write; return the current
+        # record so callers can observe its accepted/pending state.
+        return self.store.get(request_id)
+
+    def _notify_settlement(self, record: TaskRecord, *, force: bool = False) -> None:
+        """Attempt one versioned notification; the common delivery ledger owns replay."""
+
+        if self._on_settle is None or record.state not in {
+            TaskState.WAITING_FOR_USER, TaskState.SUCCEEDED, TaskState.FAILED,
+            TaskState.CANCELLED, TaskState.UNKNOWN,
+        }:
+            return
+        notification = None
+        if self._notification_renderer is not None:
+            try:
+                notification = self.store.ensure_notification(
+                    record, self._notification_renderer(record),
+                )
+                if notification.status == "delivered" or notification.delivery_obligation_id:
+                    return
+                if not force and notification.status == "injected":
+                    return
+                notification = self.store.mark_notification_attempt(notification.notification_id, force=force)
+            except Exception:
+                logger.exception("Could not prepare Codex notification for %s", record.request.request_id)
+                return
+        elif not force and (
+            record.delivery_state in {"accepted", "delivered"}
+            and record.delivery_notice_state == record.state.value
+        ):
+            return
+        try:
+            attempted = self.store.mark_delivery_attempt(record.request.request_id)
+            if notification is not None and _callable_accepts_keyword(self._on_settle, "notification"):
+                accepted = bool(self._on_settle(attempted, notification=notification))
+            else:
+                accepted = bool(self._on_settle(attempted))
+            if accepted:
+                if notification is not None:
+                    self.store.mark_notification_injected(
+                        notification.notification_id,
+                        expected_state=notification.expected_state,
+                        generation=notification.generation,
+                    )
+                    self._notification_injected_this_process.add(notification.notification_id)
+                # Retain the old task-level field for diagnostics and migration
+                # visibility; it is deliberately not used for recovery anymore.
+                self.store.mark_delivery_accepted(record.request.request_id, attempted.state)
+            else:
+                if notification is not None:
+                    self.store.mark_notification_failed(
+                        notification.notification_id,
+                        "Gateway injection was not accepted; delivery remains pending",
+                    )
+                self.store.mark_delivery_failed(
+                    record.request.request_id,
+                    "Gateway injection was not accepted; delivery remains pending",
+                )
+        except Exception as exc:  # Delivery failure must not change Codex settlement.
+            logger.exception("Codex task completion delivery failed")
+            if notification is not None:
+                try:
+                    self.store.mark_notification_failed(notification.notification_id, str(exc))
+                except Exception:
+                    logger.debug("could not persist Codex notification failure", exc_info=True)
+            try:
+                self.store.mark_delivery_failed(record.request.request_id, str(exc))
+            except Exception:
+                logger.debug("could not persist Codex task delivery failure", exc_info=True)
+
+    def _recover_notifications(self) -> None:
+        """Recover only notifications without a common delivery-ledger obligation.
+
+        The shared ledger is the sole owner once a final send has been
+        ledgered.  Pre-existing task rows have no notification row and are
+        intentionally left as legacy/unconfirmed rather than replayed.
+        """
+        if self._notification_renderer is None or self._on_settle is None:
+            return
+        for notification in self.store.unresolved_notifications():
+            if notification.notification_id in self._notification_injected_this_process:
+                continue
+            try:
+                record = self.store.get(notification.task_id)
+            except KeyError:
+                continue
+            linked = notification.delivery_obligation_id
+            if linked is None:
+                try:
+                    from gateway.delivery_ledger import find_obligation_for_notification, get_obligation
+
+                    row = find_obligation_for_notification(notification.notification_id)
+                    if row is not None:
+                        linked = str(row["obligation_id"])
+                        self.store.link_notification_obligation(
+                            notification.notification_id,
+                            expected_state=notification.expected_state,
+                            generation=notification.generation,
+                            obligation_id=linked,
+                        )
+                except Exception:
+                    logger.debug("Could not reconcile Codex notification with delivery ledger", exc_info=True)
+            if linked:
+                try:
+                    from gateway.delivery_ledger import get_obligation
+
+                    row = get_obligation(linked)
+                    if row is not None and row["state"] == "delivered":
+                        self.store.mark_notification_delivered(
+                            notification.notification_id,
+                            expected_state=notification.expected_state,
+                            generation=notification.generation,
+                            message_id=row.get("message_id"),
+                            continuation_message_ids=tuple(row.get("continuation_message_ids") or ()),
+                        )
+                except Exception:
+                    logger.debug("Could not reconcile delivered Codex notification %s", linked, exc_info=True)
+                continue
+            current_server_request_id = (
+                str(record.pending_server_request_id)
+                if record.state == TaskState.WAITING_FOR_USER and record.pending_server_request_id
+                else None
+            )
+            is_current_version = (
+                notification.expected_state == record.state
+                and notification.server_request_id == current_server_request_id
+            )
+            if not is_current_version:
+                self.store.mark_notification_superseded(
+                    notification.notification_id,
+                    f"Superseded by current task state {record.state.value}",
+                )
+                continue
+            self._notify_notification(record, notification, force=True)
+
+    def _notify_notification(
+        self, record: TaskRecord, notification: TaskNotification, *, force: bool = False,
+    ) -> None:
+        if self._on_settle is None or notification.status == "delivered":
+            return
+        if notification.delivery_obligation_id:
+            return
+        try:
+            attempted = self.store.mark_notification_attempt(notification.notification_id, force=force)
+            if _callable_accepts_keyword(self._on_settle, "notification"):
+                accepted = bool(self._on_settle(record, notification=attempted))
+            else:
+                accepted = bool(self._on_settle(record))
+            if accepted:
+                self.store.mark_notification_injected(
+                    attempted.notification_id,
+                    expected_state=attempted.expected_state,
+                    generation=attempted.generation,
+                )
+                self._notification_injected_this_process.add(attempted.notification_id)
+            else:
+                self.store.mark_notification_failed(
+                    attempted.notification_id,
+                    "Gateway injection was not accepted; delivery remains pending",
+                )
+        except Exception as exc:
+            logger.exception("Codex notification recovery failed for %s", notification.notification_id)
+            try:
+                self.store.mark_notification_failed(notification.notification_id, str(exc))
+            except Exception:
+                logger.debug("could not persist recovered Codex notification failure", exc_info=True)
+
+    def _mark_server_request(self, request_id: str, pending: Any) -> None:
+        """Persist a live server request before the worker waits for Discord."""
+        try:
+            record = self.store.transition(
+                request_id, TaskState.WAITING_FOR_USER,
+                codex_thread_id=getattr(pending, "thread_id", None) or _UNSET,
+                codex_turn_id=getattr(pending, "turn_id", None) or _UNSET,
+                error_text=str(getattr(pending, "summary", "Codex is waiting for owner input")),
+                pending_server_request_id=str(getattr(pending, "request_id", "")),
+                pending_server_request_method=str(getattr(pending, "method", "")),
+                pending_server_request_summary=str(getattr(pending, "summary", "")),
+                pending_server_request_expires_at=getattr(pending, "expires_at", None),
+            )
+        except Exception:
+            logger.exception("failed to persist pending Codex server request for %s", request_id)
+            raise
+        self._notify_settlement(record)
+
+    def _mark_server_request_settled(self, request_id: str, pending: Any, reason: str) -> None:
+        """Clear durable pending identity on timeout/cleanup/disconnect."""
+        try:
+            current = self.store.get(request_id)
+            if current.pending_server_request_id != str(getattr(pending, "request_id", "")):
+                return
+            if reason in {"timeout", "auto_timeout"}:
+                self.store.transition(
+                    request_id, TaskState.RUNNING, error_text=None,
+                    pending_server_request_id=None, pending_server_request_method=None,
+                    pending_server_request_summary=None, pending_server_request_expires_at=None,
+                )
+            else:
+                # Leave the state for _settle() to classify the turn outcome;
+                # only remove the stale request binding now.
+                self.store.transition(
+                    request_id, current.state,
+                    pending_server_request_id=None, pending_server_request_method=None,
+                    pending_server_request_summary=None, pending_server_request_expires_at=None,
+                )
+        except Exception:
+            logger.exception("failed to clear pending Codex server request for %s", request_id)
+
+    def answer(
+        self, task_id: str, server_request_id: str, response: Mapping[str, Any], *, origin: DiscordOrigin,
+    ) -> TaskAnswerResult:
+        """Answer a request after binding task, request, and authenticated origin."""
+        try:
+            record = self.store.get(task_id)
+        except KeyError:
+            return TaskAnswerResult(False, "not_found", "No Codex task exists for that task id")
+        if not _same_origin(record.request.origin, origin):
+            return TaskAnswerResult(False, "forbidden", "That Codex task is not owned by this Discord DM")
+        if record.state != TaskState.WAITING_FOR_USER or not record.pending_server_request_id:
+            return TaskAnswerResult(False, "stale", "That Codex task has no live pending server request")
+        if str(server_request_id) != record.pending_server_request_id:
+            return TaskAnswerResult(False, "mismatch", "The server request id does not match the task's live request")
+        pending = getattr(self.executor, "pending", lambda _request_id: None)(task_id)
+        if pending is None:
+            return TaskAnswerResult(
+                False, "not_live",
+                "The Codex app-server session is no longer live; this request cannot be resumed after a restart",
+            )
+        if str(getattr(pending, "request_id", "")) != record.pending_server_request_id:
+            return TaskAnswerResult(False, "mismatch", "The live Codex request does not match durable task state")
+
+        def before_release() -> None:
+            current = self.store.get(task_id)
+            if current.state != TaskState.WAITING_FOR_USER \
+                    or current.pending_server_request_id != record.pending_server_request_id:
+                raise RuntimeError("Codex task pending request changed before answer was released")
+            self.store.transition(
+                task_id, TaskState.RUNNING, error_text=None,
+                pending_server_request_id=None, pending_server_request_method=None,
+                pending_server_request_summary=None, pending_server_request_expires_at=None,
+            )
+
+        try:
+            outcome = self.executor.answer(
+                task_id, server_request_id, response, before_release=before_release,
+            )
+        except Exception as exc:
+            logger.exception("Codex task answer failed")
+            return TaskAnswerResult(False, "error", f"Could not answer the live Codex request: {type(exc).__name__}")
+        if getattr(outcome, "accepted", False):
+            return TaskAnswerResult(True, "accepted", getattr(outcome, "message", "Codex answer accepted"))
+        return TaskAnswerResult(False, getattr(outcome, "reason", "rejected"), getattr(outcome, "message", "Codex answer rejected"))
+
+    def pending_for_origin(self, origin: DiscordOrigin) -> list[TaskRecord]:
+        return self.store.pending_for_origin(
+            platform=origin.platform, profile=origin.profile,
+            conversation_id=origin.conversation_id, sender_id=origin.sender_id,
+        )
+
+
+def _same_origin(expected: DiscordOrigin, actual: DiscordOrigin) -> bool:
+    return (
+        expected.platform == actual.platform
+        and expected.profile == actual.profile
+        and expected.sender_id == actual.sender_id
+        and expected.conversation_id == actual.conversation_id
+        and expected.conversation_type == actual.conversation_type
+    )
+
+
+def _notification_payload(notification: TaskNotification, *, task_id: str, store_path: str,
+                          session_key: str) -> dict[str, Any]:
+    """Build the internal marker carried from plugin injection to final delivery."""
+    return {
+        "notification_id": notification.notification_id,
+        "task_id": str(task_id),
+        "generation": int(notification.generation),
+        "expected_state": notification.expected_state.value,
+        "store_path": str(store_path),
+        "session_key": str(session_key),
+    }
+
+
+def link_codex_notification_to_obligation(
+    *, store_path: str, notification_id: str, expected_state: str,
+    generation: int, obligation_id: str,
+) -> bool:
+    """Link a common delivery-ledger obligation to one notification version."""
+    try:
+        with CodexTaskStore(store_path) as store:
+            return store.link_notification_obligation(
+                notification_id,
+                expected_state=TaskState(expected_state),
+                generation=int(generation),
+                obligation_id=obligation_id,
+            )
+    except Exception:
+        logger.debug("Could not link Codex notification to delivery obligation", exc_info=True)
+        return False
+
+
+def mark_codex_notification_delivered(
+    *, store_path: str, notification_id: str, expected_state: str, generation: int,
+    message_id: str | None, continuation_message_ids: tuple[str, ...] = (),
+) -> bool:
+    """Record an actual platform send receipt using state/generation CAS."""
+    try:
+        with CodexTaskStore(store_path) as store:
+            return store.mark_notification_delivered(
+                notification_id,
+                expected_state=TaskState(expected_state),
+                generation=int(generation),
+                message_id=message_id,
+                continuation_message_ids=continuation_message_ids,
+            )
+    except Exception:
+        logger.debug("Could not record Codex notification delivery receipt", exc_info=True)
+        return False
+
+
+_LIVE_BRIDGES: dict[tuple[str, str, str], CodexTaskBridge] = {}
+_LIVE_BRIDGES_LOCK = threading.RLock()
+
+
+def register_live_codex_bridge(
+    *, platform: str, profile: str, conversation_id: str, bridge: CodexTaskBridge,
+) -> None:
+    """Publish one profile-scoped bridge for built-in off-turn commands."""
+    with _LIVE_BRIDGES_LOCK:
+        _LIVE_BRIDGES[(platform, profile, conversation_id)] = bridge
+
+
+def unregister_live_codex_bridge(*, platform: str, profile: str, conversation_id: str, bridge: CodexTaskBridge) -> None:
+    with _LIVE_BRIDGES_LOCK:
+        key = (platform, profile, conversation_id)
+        if _LIVE_BRIDGES.get(key) is bridge:
+            _LIVE_BRIDGES.pop(key, None)
+
+
+def _get_live_codex_bridge(*, platform: str, profile: str, conversation_id: str) -> CodexTaskBridge | None:
+    with _LIVE_BRIDGES_LOCK:
+        return _LIVE_BRIDGES.get((platform, profile, conversation_id))
+
+
+def resolve_live_codex_approval(
+    *, origin: DiscordOrigin, raw_args: str, choice: str,
+    prefer_existing_gateway_approval: bool = False,
+) -> tuple[bool, str | None]:
+    """Resolve a command/file approval from the built-in ``/approve``/``/deny`` path.
+
+    The normal no-argument form is allowed only when exactly one Codex request
+    is pending for this authenticated owner DM.  Explicit task/request ids can
+    be used when several approvals coexist and always bind both identities.
+    """
+    bridge = _get_live_codex_bridge(
+        platform=origin.platform, profile=origin.profile or "", conversation_id=origin.conversation_id,
+    )
+    if bridge is None:
+        return False, None
+    try:
+        tokens = shlex.split(raw_args or "")
+    except ValueError:
+        return True, "Could not parse the Codex approval arguments."
+    modifier_tokens = {"once", "session", "always", "permanent", "permanently"}
+    explicit = [token for token in tokens if token.lower() not in modifier_tokens and token.lower() != "all"]
+    if prefer_existing_gateway_approval and len(explicit) < 2:
+        return False, None
+    if tokens and tokens[0].lower() == "all" and len(explicit) == 0:
+        return False, None
+    pending = bridge.pending_for_origin(origin)
+    task_id: str | None = None
+    server_request_id: str | None = None
+    if len(explicit) >= 2:
+        task_id, server_request_id = explicit[0], explicit[1]
+        try:
+            record = bridge.store.get(task_id)
+        except KeyError:
+            return True, "No Codex task exists for that task id."
+        if not _same_origin(record.request.origin, origin):
+            return True, "That Codex task is not owned by this Discord DM."
+        candidates = [record]
+    elif len(explicit) == 1:
+        candidates = [record for record in pending if record.pending_server_request_id == explicit[0]]
+        if not candidates:
+            return True, "No live Codex request matches that server request id."
+        task_id = candidates[0].request.request_id
+        server_request_id = candidates[0].pending_server_request_id
+    else:
+        if not pending:
+            return False, None
+        if len(pending) > 1:
+            return True, "More than one Codex request is pending; provide <task_id> <server_request_id>."
+        candidates = pending
+        task_id = candidates[0].request.request_id
+        server_request_id = candidates[0].pending_server_request_id
+    record = candidates[0]
+    if record.pending_server_request_method not in {
+        "item/commandExecution/requestApproval", "item/fileChange/requestApproval",
+    }:
+        return True, (
+            f"This pending Codex request is {record.pending_server_request_method}; "
+            "use /codex-respond with the exact JSON response for that request type."
+        )
+    decision = "decline"
+    if choice == "approve":
+        lowered = {token.lower() for token in tokens}
+        decision = "acceptForSession" if lowered.intersection({"session", "always", "permanent", "permanently"}) else "accept"
+    result = bridge.answer(
+        task_id or "", server_request_id or "", {"decision": decision}, origin=origin,
+    )
+    return True, result.message
