+def find_obligation_for_notification(notification_id: str) -> Optional[Dict[str, Any]]:
+    """Find the one common-ledger row linked to a Codex notification version."""
+    with _DB_LOCK, _transaction() as conn:
+        cursor = conn.execute(
+            "SELECT * FROM delivery_obligations WHERE codex_notification_id=? "
