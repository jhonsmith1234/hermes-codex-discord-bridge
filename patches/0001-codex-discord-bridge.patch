+def _describe_server_request(method: str, params: Mapping[str, Any]) -> str:
+    """Build a short, redacted owner-facing description of a pending request."""
+    def clean(value: Any, limit: int = 600) -> str:
+        text = redact_sensitive_text(str(value or ""), force=True).strip()
+        return text[:limit] + ("…" if len(text) > limit else "")
+
+    if method == "item/commandExecution/requestApproval":
+        command = clean(params.get("command"), 400) or "(command details were not supplied)"
+        if params.get("networkApprovalContext"):
+            network = params.get("networkApprovalContext")
+            return f"Codex requests managed network access: {clean(network, 300)}"
+        detail = clean(params.get("reason"), 300)
+        return f"Codex requests command approval: {command}" + (f" — {detail}" if detail else "")
+    if method == "item/fileChange/requestApproval":
+        detail = clean(params.get("reason"), 300)
+        grant_root = clean(params.get("grantRoot"), 240)
+        suffix = "; ".join(part for part in (detail, f"grantRoot={grant_root}" if grant_root else "") if part)
+        return "Codex requests file-change approval" + (f": {suffix}" if suffix else "")
+    if method == "item/permissions/requestApproval":
+        reason = clean(params.get("reason"), 300)
+        cwd = clean(params.get("cwd"), 240)
+        return "Codex requests a subset of filesystem/network permissions" + \
+            (f" in {cwd}" if cwd else "") + (f" — {reason}" if reason else "")
+    if method in {"tool/requestUserInput", "item/tool/requestUserInput"}:
+        questions = params.get("questions") if isinstance(params.get("questions"), list) else []
+        labels: list[str] = []
+        for question in questions[:3]:
+            if not isinstance(question, Mapping):
+                continue
+            qid = clean(question.get("id"), 80)
+            text = "(secret question)" if question.get("isSecret") else clean(question.get("question"), 260)
+            labels.append(f"{qid}: {text}" if qid else text)
+        return "Codex requests structured input" + (" — " + " | ".join(labels) if labels else "")
+    if method == "mcpServer/elicitation/request":
+        server = clean(params.get("serverName"), 160) or "unknown MCP server"
+        mode = clean(params.get("mode"), 80) or "unknown mode"
+        message = clean(params.get("message"), 400)
+        url = clean(params.get("url"), 500)
+        suffix = "; ".join(part for part in (message, url) if part)
+        return f"MCP elicitation from {server} ({mode})" + (f": {suffix}" if suffix else "")
+    return f"Codex requested unsupported interaction: {clean(method, 160)}"
+
