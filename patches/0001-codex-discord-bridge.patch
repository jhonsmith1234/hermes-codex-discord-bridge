+class BlockingApprovalExecutor:
+    """Small executor double that exposes the bridge's live answer boundary."""
+
+    def __init__(self):
+        from agent.transports.codex_app_server_session import PendingServerRequest
+
+        self.executed: list[str] = []
+        self.pending_request = PendingServerRequest(
+            request_id="srv-1", method="item/commandExecution/requestApproval",
+            params={"command": "echo approved", "cwd": "/tmp"},
+            summary="Codex requests command approval: echo approved",
+            created_at=time.monotonic(), expires_at=None, thread_id="thr-live", turn_id="turn-live",
+            wire_request_id="srv-1",
+        )
+        self.released = threading.Event()
+
+    def execute(self, task, *, on_thread_started=None, on_turn_started=None,
+                on_server_request=None, on_server_request_settled=None):
+        self.executed.append(task.request.request_id)
+        if on_thread_started:
+            on_thread_started("thr-live")
+        if on_turn_started:
+            on_turn_started("turn-live")
+        if on_server_request:
+            on_server_request(self.pending_request)
+        assert self.released.wait(timeout=2)
+        return ExecutionResult(
+            state=TaskState.SUCCEEDED, codex_thread_id="thr-live", codex_turn_id="turn-live",
+            result_text="approved result",
+        )
+
+    def pending(self, request_id):
+        return self.pending_request if not self.released.is_set() else None
+
+    def answer(self, request_id, server_request_id, response, *, before_release=None):
+        if server_request_id != self.pending_request.request_id:
+            return SimpleNamespace(accepted=False, reason="mismatch", message="mismatch")
+        if response not in ({"decision": "accept"}, {"decision": "acceptForSession"}):
+            return SimpleNamespace(accepted=False, reason="invalid", message="invalid")
+        if before_release:
+            before_release()
+        self.released.set()
+        return SimpleNamespace(accepted=True, reason="accepted", message="Codex answer accepted")
+
+    def inspect(self, task):
+        return None
+
