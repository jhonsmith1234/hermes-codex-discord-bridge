+            bridge.future(record.request.request_id).result(timeout=2)
+            wrong_origin = DiscordOrigin("other", record.request.origin.conversation_id, "m-other")
+            forbidden = bridge.manual_recover(
+                record.request.request_id, "cancel", origin=wrong_origin, confirmation="CANCEL",
+            )
+            assert forbidden.accepted is False
+            assert forbidden.status == "forbidden"
+            missing_confirmation = bridge.manual_recover(
+                record.request.request_id, "cancel", origin=record.request.origin,
+            )
+            assert missing_confirmation.status == "confirmation_required"
+            cancelled = bridge.manual_recover(
+                record.request.request_id, "cancel", origin=record.request.origin, confirmation="CANCEL",
+            )
+            assert cancelled.accepted is True
+            assert cancelled.status == "cancelled"
+            assert store.get(record.request.request_id).state == TaskState.CANCELLED
+        finally:
+            bridge.close()
