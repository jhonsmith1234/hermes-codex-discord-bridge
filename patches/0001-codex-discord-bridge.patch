+def _timeout_response_for_request(request: PendingServerRequest) -> dict[str, Any]:
+    if request.method in {"item/commandExecution/requestApproval", "item/fileChange/requestApproval"}:
+        return {"decision": "decline"}
+    if request.method == "item/permissions/requestApproval":
+        return {"permissions": {}}
+    if request.method in {"tool/requestUserInput", "item/tool/requestUserInput"}:
+        return {"answers": {}}
+    if request.method == "mcpServer/elicitation/request":
+        return {"action": "cancel", "content": None, "_meta": None}
+    return {}
+
+
+def _validate_server_request_response(
+    request: PendingServerRequest, raw_response: Mapping[str, Any],
+) -> tuple[dict[str, Any] | None, str | None]:
+    """Validate a human response against the exact app-server request family."""
+    response = copy.deepcopy(dict(raw_response))
+    method = request.method
+    if method in {"item/commandExecution/requestApproval", "item/fileChange/requestApproval"}:
+        if set(response) != {"decision"} or response.get("decision") not in {"accept", "acceptForSession", "decline", "cancel"}:
+            return None, "Approval responses must contain only decision=accept, acceptForSession, decline, or cancel"
+        return response, None
+    if method == "item/permissions/requestApproval":
+        allowed = {"permissions", "scope", "strictAutoReview"}
+        if set(response) - allowed or not isinstance(response.get("permissions"), Mapping):
+            return None, "Permission responses require a permissions object and optional scope"
+        scope = response.get("scope", "turn")
+        if scope not in {"turn", "session"}:
+            return None, "Permission scope must be 'turn' or 'session'"
+        if "strictAutoReview" in response and response["strictAutoReview"] is not None \
+                and not isinstance(response["strictAutoReview"], bool):
+            return None, "strictAutoReview must be boolean or null"
+        requested = request.params.get("permissions")
+        if not isinstance(requested, Mapping):
+            requested = {}
+        if not _permission_subset(response["permissions"], requested):
+            return None, "The granted permissions must be a subset of the permissions Codex requested"
+        return response, None
+    if method in {"tool/requestUserInput", "item/tool/requestUserInput"}:
+        if set(response) != {"answers"} or not isinstance(response.get("answers"), Mapping):
+            return None, "Structured input responses require an answers object"
+        questions = request.params.get("questions") if isinstance(request.params.get("questions"), list) else []
+        question_ids = {str(q.get("id")) for q in questions if isinstance(q, Mapping) and q.get("id")}
+        answers = response["answers"]
+        if question_ids and set(str(key) for key in answers) != question_ids:
+            return None, "Answers must contain exactly the requested question ids"
+        normalized: dict[str, dict[str, list[str]]] = {}
+        for key, value in answers.items():
+            if not isinstance(value, Mapping) or set(value) != {"answers"} or not isinstance(value.get("answers"), list):
+                return None, f"Answer for {key!r} must be an object with an answers string array"
+            if not all(isinstance(item, str) for item in value["answers"]):
+                return None, f"Answer for {key!r} contains a non-string value"
+            normalized[str(key)] = {"answers": list(value["answers"])}
+        return {"answers": normalized}, None
+    if method == "mcpServer/elicitation/request":
+        allowed = {"action", "content", "_meta"}
+        if set(response) - allowed or response.get("action") not in {"accept", "decline", "cancel"}:
+            return None, "MCP elicitation responses require action=accept, decline, or cancel"
+        action = response["action"]
+        content = response.get("content")
+        if action != "accept":
+            if content is not None:
+                return None, "Decline or cancel responses must use content=null"
+            response["content"] = None
+        else:
+            mode = request.params.get("mode")
+            if mode in {"form", "openai/form", "openaiForm"}:
+                if not isinstance(content, Mapping):
+                    return None, "Form elicitation acceptance requires a content object"
+                schema = request.params.get("requestedSchema")
+                if isinstance(schema, Mapping):
+                    error = _validate_form_content(content, schema)
+                    if error is not None:
+                        return None, error
+            elif mode == "url":
+                if content is not None and not isinstance(content, Mapping):
+                    return None, "URL elicitation content must be an object or null"
+            else:
+                return None, f"Unsupported MCP elicitation mode: {mode!r}"
+        if "_meta" in response and response["_meta"] is not None and not isinstance(response["_meta"], Mapping):
+            return None, "MCP elicitation _meta must be an object or null"
+        response.setdefault("content", None)
+        response.setdefault("_meta", None)
+        return response, None
+    return None, f"No response validator exists for {method}"
+
+
+def _permission_subset(granted: Any, requested: Any) -> bool:
+    if not isinstance(granted, Mapping) or not isinstance(requested, Mapping):
+        return not granted
+    for key, value in granted.items():
+        if key not in requested or not _permission_value_subset(value, requested[key]):
+            return False
+    return True
+
+
+def _permission_value_subset(granted: Any, requested: Any) -> bool:
+    if isinstance(granted, Mapping):
+        return isinstance(requested, Mapping) and all(
+            key in requested and _permission_value_subset(value, requested[key])
+            for key, value in granted.items()
+        )
+    if isinstance(granted, list):
+        if not isinstance(requested, list):
+            return False
+        return all(any(item == allowed for allowed in requested) for item in granted)
+    if isinstance(granted, bool):
+        return granted is False or requested is True
+    return granted == requested
+
+
+def _validate_form_content(content: Mapping[str, Any], schema: Mapping[str, Any]) -> str | None:
+    properties = schema.get("properties") if isinstance(schema.get("properties"), Mapping) else {}
+    required = schema.get("required") if isinstance(schema.get("required"), list) else []
+    unknown = set(content) - set(properties)
+    if unknown:
+        return f"Form content contains fields not requested by the MCP schema: {', '.join(sorted(map(str, unknown)))}"
+    missing = [str(key) for key in required if key not in content]
+    if missing:
+        return f"Form content is missing required fields: {', '.join(missing)}"
+    for key, value in content.items():
+        field_schema = properties.get(key)
+        if not isinstance(field_schema, Mapping):
+            continue
+        if "enum" in field_schema and value not in field_schema.get("enum", []):
+            return f"Form field {key!r} is not one of the requested enum values"
+        expected = field_schema.get("type")
+        valid = {
+            "string": isinstance(value, str),
+            "number": isinstance(value, (int, float)) and not isinstance(value, bool),
+            "integer": isinstance(value, int) and not isinstance(value, bool),
+            "boolean": isinstance(value, bool),
+            "array": isinstance(value, list),
+            "object": isinstance(value, Mapping),
+        }.get(expected, True)
+        if not valid:
+            return f"Form field {key!r} has the wrong type for the requested schema"
+    return None
+
