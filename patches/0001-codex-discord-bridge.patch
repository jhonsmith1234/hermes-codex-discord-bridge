+class FakeExecutor:
+    def __init__(self, outcome: ExecutionResult):
+        self.outcome = outcome
+        self.executed: list[str] = []
+        self.inspected: list[str] = []
+
+    def execute(self, task, *, on_thread_started=None, on_turn_started=None):
+        self.executed.append(task.request.request_id)
+        if on_thread_started:
+            on_thread_started(self.outcome.codex_thread_id or "thread-fake")
+        if on_turn_started and self.outcome.codex_turn_id:
+            on_turn_started(self.outcome.codex_turn_id)
+        return self.outcome
+
+    def inspect(self, task):
+        self.inspected.append(task.request.request_id)
+        return self.outcome
