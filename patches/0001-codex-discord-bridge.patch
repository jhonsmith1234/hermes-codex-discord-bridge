index 0000000..17e2a41
--- /dev/null
+++ b/gateway/codex_app_tasks.py
@@ -0,0 +1,1871 @@
+"""Hermes -> Codex app-server task adapter.
+
+This module keeps Discord and gateway routing outside the Codex executor while
+providing the durable boundary used by the owner-DM integration:
+
+* a request envelope whose reply target is derived from the Discord event;
+* an SQLite mapping from Hermes request ids to Codex thread/turn ids;
+* idempotent admission for a retried Discord message;
+* conservative state transitions, including ``unknown`` for transport
+  uncertainty; and
+* a Codex app-server executor plus a read-only reconciliation path; and
+* restart-safe, versioned completion-delivery bookkeeping.
+
+The module is safe to exercise with a temporary database.  Production callers
+must pass an explicit state-store path and must opt in to the asynchronous
+executor.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import inspect
+import json
+import logging
+import os
+import shlex
+import sqlite3
+import threading
+import time
+import uuid
+from concurrent.futures import Future, ThreadPoolExecutor
+from dataclasses import dataclass
+from enum import StrEnum
+from pathlib import Path
+from typing import Any, Callable, Mapping, Protocol
+
+logger = logging.getLogger(__name__)
+
+
+class TaskState(StrEnum):
+    QUEUED = "queued"
+    RUNNING = "running"
+    WAITING_FOR_USER = "waiting_for_user"
+    SUCCEEDED = "succeeded"
+    FAILED = "failed"
+    CANCELLED = "cancelled"
+    UNKNOWN = "unknown"
+
+
+TERMINAL_STATES = frozenset({TaskState.SUCCEEDED, TaskState.FAILED, TaskState.CANCELLED})
+
+_ALLOWED_TRANSITIONS: dict[TaskState, frozenset[TaskState]] = {
+    TaskState.QUEUED: frozenset({TaskState.QUEUED, TaskState.RUNNING, TaskState.CANCELLED, TaskState.UNKNOWN}),
+    TaskState.RUNNING: frozenset({
+        TaskState.RUNNING, TaskState.WAITING_FOR_USER, TaskState.SUCCEEDED,
+        TaskState.FAILED, TaskState.CANCELLED, TaskState.UNKNOWN,
+    }),
+    TaskState.WAITING_FOR_USER: frozenset({
+        TaskState.WAITING_FOR_USER, TaskState.RUNNING, TaskState.SUCCEEDED,
+        TaskState.FAILED, TaskState.CANCELLED, TaskState.UNKNOWN,
+    }),
+    TaskState.UNKNOWN: frozenset({
+        TaskState.UNKNOWN, TaskState.QUEUED, TaskState.RUNNING, TaskState.WAITING_FOR_USER,
+        TaskState.SUCCEEDED, TaskState.FAILED, TaskState.CANCELLED,
+    }),
+    TaskState.SUCCEEDED: frozenset({TaskState.SUCCEEDED}),
+    TaskState.FAILED: frozenset({TaskState.FAILED}),
+    TaskState.CANCELLED: frozenset({TaskState.CANCELLED}),
+}
+
+
+class TaskConflictError(RuntimeError):
+    """Raised when one Discord message is reused for a different request."""
+
+
+class InvalidStateTransition(RuntimeError):
+    """Raised when a task would move to an unsafe state."""
+
+
+@dataclass(frozen=True, slots=True)
+class DiscordOrigin:
+    """Identity taken from an inbound Discord event.
+
+    The model plan never supplies these fields.  In particular,
+    ``reply_conversation_id`` is derived from ``conversation_id`` and cannot be
+    redirected by text generated by Hermes or Codex.
+    """
+
+    sender_id: str
+    conversation_id: str
+    message_id: str
+    thread_id: str | None = None
+    conversation_type: str = "dm"
+    platform: str = "discord"
+    profile: str | None = None
+
+    def __post_init__(self) -> None:
+        for name in ("sender_id", "conversation_id", "message_id", "conversation_type", "platform"):
+            if not str(getattr(self, name) or "").strip():
+                raise ValueError(f"{name} is required")
+
+    @property
+    def reply_target(self) -> dict[str, str | None]:
+        """Return the only reply destination the bridge is allowed to use."""
+
+        return {
+            "platform": self.platform,
+            "conversation_id": self.conversation_id,
+            "thread_id": self.thread_id,
+        }
+
+    @property
+    def dedupe_key(self) -> tuple[str, str, str]:
+        return self.platform, self.conversation_id, self.message_id
+
+
+@dataclass(frozen=True, slots=True)
+class TaskPlan:
+    """The Hermes-authored execution plan sent to Codex."""
+
+    purpose: str
+    steps: tuple[str, ...]
+    target_services: tuple[str, ...]
+    scope: str
+    completion_conditions: tuple[str, ...]
+
+    def __post_init__(self) -> None:
+        if not self.purpose.strip():
+            raise ValueError("purpose is required")
+        if not self.scope.strip():
+            raise ValueError("scope is required")
+        if not self.completion_conditions:
+            raise ValueError("at least one completion condition is required")
+
+    @classmethod
+    def from_mapping(cls, raw: Mapping[str, Any]) -> "TaskPlan":
+        """Accept only plan fields; routing/delivery fields are intentionally ignored."""
+
+        def strings(value: Any) -> tuple[str, ...]:
+            if value is None:
+                return ()
+            if isinstance(value, str):
+                return (value.strip(),) if value.strip() else ()
+            return tuple(str(item).strip() for item in value if str(item).strip())
+
+        return cls(
+            purpose=str(raw.get("purpose") or "").strip(),
+            steps=strings(raw.get("steps") or raw.get("procedure")),
+            target_services=strings(raw.get("target_services") or raw.get("services")),
+            scope=str(raw.get("scope") or "").strip(),
+            completion_conditions=strings(raw.get("completion_conditions") or raw.get("done_when")),
+        )
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "purpose": self.purpose,
+            "steps": list(self.steps),
+            "target_services": list(self.target_services),
+            "scope": self.scope,
+            "completion_conditions": list(self.completion_conditions),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class TaskRequest:
+    request_id: str
+    origin: DiscordOrigin
+    plan: TaskPlan
+    created_at: float
+
+    @property
+    def reply_target(self) -> dict[str, str | None]:
+        return self.origin.reply_target
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "request_id": self.request_id,
+            "origin": {
+                "platform": self.origin.platform,
+                "sender_id": self.origin.sender_id,
+                "conversation_id": self.origin.conversation_id,
+                "thread_id": self.origin.thread_id,
+                "message_id": self.origin.message_id,
+                "conversation_type": self.origin.conversation_type,
+                "profile": self.origin.profile,
+            },
+            "plan": self.plan.to_dict(),
+            "reply_target": self.reply_target,
+            "created_at": self.created_at,
+        }
+
+
+def build_task_request(
+    origin: DiscordOrigin,
+    plan: Mapping[str, Any] | TaskPlan,
+    *,
+    request_id: str | None = None,
+    now: float | None = None,
+) -> TaskRequest:
+    """Build a request from a Discord event and an Hermes plan.
+
+    A mapping may contain an untrusted ``reply_target`` key from a model output;
+    it is ignored because the reply destination comes only from ``origin``.
+    """
+
+    task_plan = plan if isinstance(plan, TaskPlan) else TaskPlan.from_mapping(plan)
+    stable_request_id = request_id or str(
+        uuid.uuid5(
+            uuid.NAMESPACE_URL,
+            f"hermes-discord:{origin.platform}:{origin.conversation_id}:{origin.message_id}",
+        )
+    )
+    return TaskRequest(
+        request_id=stable_request_id,
+        origin=origin,
+        plan=task_plan,
+        created_at=float(time.time() if now is None else now),
+    )
+
+
+def render_codex_prompt(request: TaskRequest) -> str:
+    """Render the task payload without exposing Discord routing metadata."""
+
+    payload = {
+        "request_id": request.request_id,
+        "purpose": request.plan.purpose,
+        "steps": list(request.plan.steps),
+        "target_services": list(request.plan.target_services),
+        "scope": request.plan.scope,
+        "completion_conditions": list(request.plan.completion_conditions),
+    }
+    return (
+        "You are executing a bounded Hermes request. Keep all actions within the stated scope. "
+        "Do not send Discord messages or choose a reply destination. If a permission, login, or "
+        "human confirmation is required, stop and report that requirement instead of guessing.\n\n"
+        + json.dumps(payload, ensure_ascii=False, sort_keys=True)
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class TaskRecord:
+    request: TaskRequest
+    state: TaskState
+    codex_thread_id: str | None
+    codex_turn_id: str | None
+    result_text: str | None
+    error_text: str | None
+    updated_at: float
+    delivery_state: str = "pending"
+    delivery_attempts: int = 0
+    delivery_error: str | None = None
+    delivery_notice_state: str | None = None
+    pending_server_request_id: str | None = None
+    pending_server_request_method: str | None = None
+    pending_server_request_summary: str | None = None
+    pending_server_request_expires_at: float | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class TaskNotification:
+    """One owner-DM notification version, separate for each state/RPC identity."""
+
+    notification_id: str
+    task_id: str
+    generation: int
+    expected_state: TaskState
+    server_request_id: str | None
+    content: str
+    status: str
+    attempts: int
+    error_text: str | None
+    delivery_obligation_id: str | None
+    message_id: str | None
+    continuation_message_ids: tuple[str, ...]
+    created_at: float
+    updated_at: float
+
+
+@dataclass(frozen=True, slots=True)
+class ExecutionResult:
+    state: TaskState
