+def test_manual_recovery_retry_requires_explicit_confirmation_and_starts_one_new_turn(tmp_path):
+    class RetryExecutor:
+        def __init__(self):
+            self.executed: list[str] = []
+            self.outcomes = [
+                ExecutionResult(state=TaskState.UNKNOWN, codex_thread_id="thr-old", error_text="lost"),
+                ExecutionResult(state=TaskState.SUCCEEDED, codex_thread_id="thr-new", result_text="retried"),
+            ]
+
+        def execute(self, task, *, on_thread_started=None, on_turn_started=None):
+            self.executed.append(task.request.request_id)
+            outcome = self.outcomes[len(self.executed) - 1]
+            if on_thread_started:
+                on_thread_started(outcome.codex_thread_id or "thread-fake")
+            return outcome
+
+        def inspect(self, task):
+            return None
+
+    executor = RetryExecutor()
+    with CodexTaskStore(tmp_path / "tasks.sqlite") as store:
+        bridge = CodexTaskBridge(store, executor)
+        try:
+            record, _ = bridge.accept(make_request(message_id="manual-retry"))
+            bridge.future(record.request.request_id).result(timeout=2)
+            rejected = bridge.manual_recover(
+                record.request.request_id, "retry", origin=record.request.origin,
+            )
+            assert rejected.accepted is False
+            assert rejected.status == "confirmation_required"
+            assert executor.executed == [record.request.request_id]
+
+            queued = bridge.manual_recover(
+                record.request.request_id, "retry", origin=record.request.origin, confirmation="RETRY",
+            )
+            assert queued.accepted is True
+            assert queued.status == "queued"
+            bridge.future(record.request.request_id).result(timeout=2)
+            retried = store.get(record.request.request_id)
+            assert retried.state == TaskState.SUCCEEDED
+            assert retried.result_text == "retried"
+            assert executor.executed == [record.request.request_id, record.request.request_id]
+        finally:
+            bridge.close()
+
