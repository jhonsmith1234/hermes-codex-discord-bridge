+def test_recovery_rechecks_running_thread_without_resubmitting(tmp_path):
+    class EventuallyDone(FakeExecutor):
+        def __init__(self):
+            super().__init__(ExecutionResult(state=TaskState.RUNNING, codex_thread_id="thr-live"))
+            self.reads = 0
+
+        def inspect(self, task):
+            self.inspected.append(task.request.request_id)
+            self.reads += 1
+            if self.reads < 3:
+                return ExecutionResult(state=TaskState.RUNNING, codex_thread_id="thr-live")
+            return ExecutionResult(
+                state=TaskState.SUCCEEDED, codex_thread_id="thr-live", codex_turn_id="turn-live",
+                result_text="recovered",
+            )
+
+    path = tmp_path / "tasks.sqlite"
+    with CodexTaskStore(path) as store:
+        request = make_request()
+        store.register(request)
+        store.transition(request.request_id, TaskState.RUNNING, codex_thread_id="thr-live")
+    executor = EventuallyDone()
+    with CodexTaskStore(path) as store:
+        bridge = CodexTaskBridge(store, executor, reconcile_delay=0.001)
+        try:
+            bridge.recover()
+            bridge.future(request.request_id).result(timeout=2)
+            assert store.get(request.request_id).state == TaskState.SUCCEEDED
+            assert executor.executed == []
+            assert len(executor.inspected) == 3
+        finally:
+            bridge.close()
